{
  "version": "2.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/labd/react-abode"
  },
  "packageManager": "pnpm@12.15.0",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "changeset": "pnpm exec changeset",
    "get:changes": "git log --format=%B --no-merges HEAD  ^master | pbcopy",
    "husky:install": "pnpm exec husky install",
    "lint": "eslint --ext .ts,.tsx src",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "pnpm build"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "name": "react-abode",
  "author": "Bram Kaashoek",
  "module": "dist/index.mjs",
  "devDependencies": {
    "@changesets/cli": "^2.24.2",
    "@types/jsdom": "^20.0.0",
    "@types/react": "^18.0.15",
    "@types/react-dom": "^18.0.6",
    "@typescript-eslint/eslint-plugin": "^5.33.0",
    "@typescript-eslint/parser": "^5.33.0",
    "eslint": "^8.21.0",
    "fast-check": "^3.1.1",
    "husky": "^8.0.1",
    "jsdom": "^30.1.3",
    "mutationobserver-shim": "^0.3.7",
    "prettier": "^2.7.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.1",
    "tsdown": "^0.23.1",
    "tslib": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "tiny-current-script": "^1.0.0"
  }
}

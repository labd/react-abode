{
  "version": "2.1.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labd/react-abode.git"
  },
  "packageManager": "pnpm@12.12.0",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12"
  },
  "scripts": {
    "start": "tsdown --watch",
    "build": "tsdown",
    "changeset": "pnpm exec changeset",
    "get:changes": "git log --format=%B --no-merges HEAD  ^master | pbcopy",
    "husky:install": "husky",
    "lint": "biome check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "pnpm build",
    "format": "biome check --fix",
    "check": "biome check && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "publish:ci": "pnpm build && pnpm changeset publish",
    "publish:version": "pnpm changeset version && pnpm format"
  },
  "name": "react-abode",
  "author": "Bram Kaashoek",
  "module": "dist/index.mjs",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "mutationobserver-shim": "^0.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "tiny-current-script": "^1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
